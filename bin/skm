#!/usr/bin/env bash
# skm —— 本地 skill 仓库管理器的启动脚本
#
# 本脚本只负责定位实现并交给 python3，它自己不含业务逻辑。
#
# 实现位置按「脚本所在目录的上一级」推导，依次尝试：
#   <ROOT>/lib/skm   安装后的位置（install.sh 把实现复制到这里）
#   <ROOT>/src/skm   源码树里的位置（直接跑克隆目录时）
#
# 典型布局：
#   安装后   ~/.skill-manager/{bin/skm, lib/skm/, skills/, config.toml}
#   源码树   <clone>/{bin/skm, src/skm/, tests/}
#
# 数据位置（与实现分开，安装/卸载都不动它）：
#   仓库   ${SKM_BASE_DIR:-~/.skill-manager}/skills/
#   配置   ${SKM_BASE_DIR:-~/.skill-manager}/config.toml
set -euo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(dirname -- "$(dirname -- "${SELF}")")"

IMPL=""
for candidate in "${ROOT}/lib/skm" "${ROOT}/src/skm"; do
  if [ -d "$candidate" ]; then
    IMPL="$(dirname -- "$candidate")"
    break
  fi
done

if [ -z "$IMPL" ]; then
  echo "skm: 找不到实现（已查找 ${ROOT}/lib/skm 与 ${ROOT}/src/skm）" >&2
  echo "     若安装目录被破坏，重新运行 install.sh 即可修复。" >&2
  exit 1
fi

PYTHON="${SKM_PYTHON:-python3}"
if ! command -v "${PYTHON}" >/dev/null 2>&1; then
  echo "skm: 找不到 ${PYTHON}（可用 SKM_PYTHON 指定解释器）" >&2
  exit 1
fi

# Python 3.11+ 才有 tomllib；先给出明确提示，避免 3.10 上报 ImportError
if ! "${PYTHON}" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)'; then
  ver="$("${PYTHON}" -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
  echo "skm: 需要 Python 3.11 或更新版本（当前 ${PYTHON} 是 ${ver}）" >&2
  exit 1
fi

exec env PYTHONPATH="${IMPL}${PYTHONPATH:+:${PYTHONPATH}}" "${PYTHON}" -m skm "$@"
